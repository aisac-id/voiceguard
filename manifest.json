{
  "manifest_version": 3,
  "name": "VoiceGuard — Real vs AI Voice Radar",
  "version": "1.0.0",
  "description": "Flags robotic TTS, looped replays and synthetic voices in meetings, tabs and your mic. Five-signal on-device analysis. No cloud, no uploads.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open VoiceGuard",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}